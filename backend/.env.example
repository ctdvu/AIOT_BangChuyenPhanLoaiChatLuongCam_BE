# Sao chép thành backend/.env và thay user/password bằng tài khoản MySQL của bạn.
DATABASE_URL=mysql+pymysql://orange_user:orange_password@127.0.0.1:3306/orange_sorting?charset=utf8mb4
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_IMAGE_SIZE_MB=10
# Camera: RFC1918 IPv4 / ULA IPv6 allowed by default. Exact extra hostnames/IPs only.
CAMERA_ALLOWED_HOSTS=[]
CAMERA_SIMULATION_ENABLED=false
CAMERA_CONNECT_TIMEOUT=5
CAMERA_READ_TIMEOUT=3
CAMERA_FRAME_MAX_AGE=2
CAMERA_PAIR_MAX_SKEW=0.25
